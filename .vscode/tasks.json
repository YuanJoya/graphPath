{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build graph",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-Wall",
        "-Wextra",
        "-std=c11",
        "main.c",
        "graph_matrix.c",
        "floyd.c",
        "graph_ortho.c",
        "dijkstra.c",
        "heap.c",
        "graph_edge.c",
        "bellman.c",
        "-o",
        "app.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
